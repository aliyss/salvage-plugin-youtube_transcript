{
  "pluginApiVersion": 1,
  "id": "salvage-plugin-youtube_transcript",
  "name": "YouTube transcript",
  "version": "0.1.0",
  "runtime": { "entry": "dist/plugin.js" },
  "provides": [
    {
      "data": "youtube-transcript",
      "when": { "link.provider": ["youtube"] },
      "command": "read-transcript",
      "timeoutMs": 25000
    }
  ],
  "settings": [
    {
      "key": "language",
      "kind": "select",
      "label": "Caption language",
      "default": "en",
      "options": [
        { "value": "en", "label": "English" },
        { "value": "de", "label": "German" },
        { "value": "fr", "label": "French" },
        { "value": "es", "label": "Spanish" }
      ]
    },
    {
      "key": "autoGenerated",
      "kind": "toggle",
      "label": "Use auto-generated captions",
      "default": true
    },
    {
      "key": "maxLines",
      "kind": "number",
      "label": "Maximum lines (0 keeps all)",
      "default": 0,
      "min": 0,
      "max": 20000
    }
  ]
}
